<UserControl x:Class="FramePilot.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="FILTER" Style="{StaticResource CardTitle}" />
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Bottom">
                    <CheckBox Content="Show operating system processes" IsChecked="{Binding ShowSystemProcesses}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                    <Button Content="Ask the application to close"
                            Command="{Binding CloseSelectedCommand}"
                            Style="{StaticResource DangerButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2"
                  Margin="0,12,0,0"
                  ItemsSource="{Binding Processes}"
                  SelectedItem="{Binding SelectedProcess}"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80" />
                <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="110" />
                <DataGridTextColumn Header="Memory" Binding="{Binding MemoryText}" Width="120" />
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource InfoPanel}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CardTitle}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource CardTitle}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Text="Only applications that use CPU time or a noticeable amount of memory are listed. FramePilot never terminates a process: it posts a close message to the windows of the application you selected, and the application decides whether it closes. System, driver, security and update processes are blocked, and a process without a window is not touched at all." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
