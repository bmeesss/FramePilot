<UserControl x:Class="FramePilot.App.Views.GameSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,22,26,26">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource PageSubtitle}" />

            <Border Style="{StaticResource InfoPanel}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="WHAT A SESSION DOES" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource CardTitle}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Text="FramePilot activates a power plan that already exists on this machine, remembers the plan that was active before and restores it when the session ends, when the game exits, or when FramePilot is closed unexpectedly. It does not create power plans, it does not change the registry and it does not claim that a different plan makes the game faster. A power plan can increase power consumption and temperatures, and on many systems it makes no measurable difference at all." />
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="GAME" Style="{StaticResource CardTitle}" />
                        <TextBox Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                        <Button Content="Browse for the executable"
                                Command="{Binding BrowseGameCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0" />
                        <TextBlock Text="Command line arguments (optional)" Style="{StaticResource CardTitle}" Margin="0,14,0,0" />
                        <TextBox Text="{Binding GameArguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                        <CheckBox Content="Start the game when the session starts"
                                  IsChecked="{Binding LaunchGame}"
                                  Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="POWER PLAN" Style="{StaticResource CardTitle}" />
                        <Button Content="Reload the power plans"
                                Command="{Binding LoadPlansCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0" />
                        <ComboBox Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding PowerPlans}"
                                  SelectedItem="{Binding SelectedPowerPlan}"
                                  DisplayMemberPath="Name"
                                  Margin="0,10,0,0" />
                        <TextBlock Style="{StaticResource CardTitle}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Text="Only the plans that Windows already provides are listed. FramePilot never creates a plan and never changes one without your confirmation." />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource InfoPanel}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SESSION STATUS" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding SessionStateText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Content="Start session"
                                Command="{Binding StartCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0" />
                        <Button Content="End session"
                                Command="{Binding EndCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource CardTitle}"
                       TextWrapping="Wrap"
                       Margin="0,14,0,0"
                       Text="Recovery journal: FramePilot writes the original and the temporary power plan to a small journal file before it changes anything. If the application is interrupted, the next start restores the original plan - but only when the plan that is active is still the one FramePilot applied. A power plan that you changed yourself in the meantime is never overwritten." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
