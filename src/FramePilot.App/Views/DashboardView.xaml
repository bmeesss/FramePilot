<UserControl x:Class="FramePilot.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,22,26,26">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource PageSubtitle}" />

            <UniformGrid Columns="4" Margin="0,18,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="CPU UTILIZATION" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding CpuValue}" Style="{StaticResource CardValue}" />
                        <ProgressBar Value="{Binding CpuBarValue}" Maximum="100" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding CpuDetail}" Style="{StaticResource CardTitle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="10,0">
                    <StackPanel>
                        <TextBlock Text="PHYSICAL MEMORY" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding MemoryValue}" Style="{StaticResource CardValue}" />
                        <ProgressBar Value="{Binding MemoryBarValue}" Maximum="100" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource CardTitle}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="10,0">
                    <StackPanel>
                        <TextBlock Text="FREE STORAGE" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding StorageValue}" Style="{StaticResource CardValue}" />
                        <TextBlock Text="Sum of the free space of all ready drives"
                                   Style="{StaticResource CardTitle}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ACTIVE POWER PLAN" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding PowerPlanValue}" Style="{StaticResource CardValue}" FontSize="18" />
                        <TextBlock Text="Read with powercfg /getactivescheme"
                                   Style="{StaticResource CardTitle}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource InfoPanel}" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SYSTEM" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding SystemInfoValue}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="16,0,0,0">
                        <TextBlock Text="{Binding UptimeValue, StringFormat='Uptime {0}'}"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding LastUpdated, StringFormat='Sampled at {0}'}"
                                   Style="{StaticResource CardTitle}"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0" />
                        <CheckBox Content="Refresh automatically" IsChecked="{Binding AutoRefresh}" Margin="0,10,0,0" />
                        <Button Content="Refresh now"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Right"
                                Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="PROCESSES WITH THE HIGHEST CPU USAGE" Style="{StaticResource CardTitle}" Margin="0,20,0,8" />

            <DataGrid ItemsSource="{Binding TopProcesses}" Height="280" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80" />
                    <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="100" />
                    <DataGridTextColumn Header="Memory" Binding="{Binding MemoryText}" Width="110" />
                    <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="3*" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource CardTitle}"
                       TextWrapping="Wrap"
                       Margin="0,14,0,0"
                       Text="How to read these values: CPU utilisation is derived from the Windows system time counters over the sampling interval. Memory is the physical RAM of the machine, not the memory of a single application. The first sample only establishes the reference values, so the CPU percentage starts with the second one. A process that just started has no CPU percentage yet and is shown as &quot;Unavailable&quot;." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
